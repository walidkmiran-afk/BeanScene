@model SittingFormViewModel
@using Microsoft.EntityFrameworkCore
@inject BeanScene.Web.Data.ApplicationDbContext Db
@{
    var hours = Db.StoreHours.AsNoTracking().ToList();
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input type="hidden" asp-for="SittingId" />
<input type="hidden" asp-for="RowVersion" />
<div class="row">
    <div class="col-md-4 mb-3"><label asp-for="SittingType" class="form-label"></label>
        <select asp-for="SittingType" class="form-select" asp-items="Html.GetEnumSelectList<SittingType>()"></select></div>
    <div class="col-md-4 mb-3"><label asp-for="SittingDate" class="form-label"></label>
        <input type="date" name="SittingDate" value="@Model.SittingDate.ToString("yyyy-MM-dd")" class="form-control" />
        <span asp-validation-for="SittingDate" class="text-danger"></span></div>
    <div class="col-md-4 mb-3"><label asp-for="Capacity" class="form-label"></label>
        <input asp-for="Capacity" class="form-control" /><span asp-validation-for="Capacity" class="text-danger"></span></div>
</div>
<div class="row">
    <div class="col-md-4 mb-3"><label asp-for="StartTime" class="form-label"></label>
        <input type="time" name="StartTime" value="@Model.StartTime.ToString("HH:mm")" class="form-control" />
        <span asp-validation-for="StartTime" class="text-danger"></span></div>
    <div class="col-md-4 mb-3"><label asp-for="EndTime" class="form-label"></label>
        <input type="time" name="EndTime" value="@Model.EndTime.ToString("HH:mm")" class="form-control" />
        <span asp-validation-for="EndTime" class="text-danger"></span></div>
</div>
<div class="row">
    <div class="col-md-4 mb-3"><div class="form-check">
        <input asp-for="IsClosed" class="form-check-input" /><label asp-for="IsClosed" class="form-check-label"></label></div></div>
</div>
<script>
        (function () {
            var isNew = @(Model.SittingId == 0 ? "true" : "false");
            if (!isNew) return;
            var type = document.getElementById("SittingType");
            var date = document.querySelector("input[name=SittingDate]");
            var start = document.querySelector("input[name=StartTime]");
            var end = document.querySelector("input[name=EndTime]");
            var capacity = document.querySelector("input[name=Capacity]");
            // key = weekday number (0 = Sunday) followed by the sitting type
            var hours = {
    @foreach (var h in hours)
    {
                    <text>"@((int)h.DayOfWeek)@(h.SittingType)": ["@(h.StartTime.ToString("HH:mm"))", "@(h.EndTime.ToString("HH:mm"))", @h.Capacity],</text>
    }
            };
            function apply() {
                if (!date.value) return;
                var day = new Date(date.value + "T00:00:00").getDay();
                var h = hours[day + type.options[type.selectedIndex].text];
                if (h) { start.value = h[0]; end.value = h[1]; capacity.value = h[2]; }
            }
            type.addEventListener("change", apply);
            date.addEventListener("change", apply);
            if (@(Context.Request.Method == "GET" ? "true" : "false")) apply();
        })();
</script>