@model SittingFormViewModel
@{ ViewData["Title"] = "Edit sitting"; }
<h1 class="h3 mb-3">Edit sitting</h1>
<form asp-action="Edit" asp-route-id="@Model.SittingId" method="post">
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary" type="submit">Save changes</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
