@using BeanScene.Web.Controllers
@using BeanScene.Web.Services
@model ScheduleViewModel
@{
    string Badge(ReservationStatus s) => s switch
    {
        ReservationStatus.Pending => "bg-warning text-dark",
        ReservationStatus.Confirmed => "bg-primary",
        ReservationStatus.Seated => "bg-info text-dark",
        ReservationStatus.Completed => "bg-success",
        _ => "bg-secondary"
    };
}
<script src="~/js/add-booking.js"></script>
@if (Model.Selected.HasValue)
{
    var sel = Model.Selected.Value;
    var items = Model.SelectedSittings;

    @* One hidden panel per sitting. Clicking a Bookings number shows that sitting's panel only. *@
    <div class="mx-auto bk-area" id="bkPanels" style="max-width:660px;font-size:.8rem">
    @foreach (var item in items)
    {
        var s = item.Sitting;
        var list = Model.DayBookings.Where(b => b.SittingId == s.SittingId).ToList();
        var returnUrl = Url.Action("Index", "Sittings", new { selected = sel.ToString("yyyy-MM-dd"), open = s.SittingId }) ?? "";
        // The restaurant closes when the last open sitting of the day ends.
        var closesAt = items.Where(x => !x.Sitting.IsClosed).Select(x => x.Sitting.EndTime).DefaultIfEmpty(s.EndTime).Max();
        <div class="card mb-4 bk-panel" data-sitting="@s.SittingId" style="display:none">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
                <strong>
                    @s.Name bookings
                    <span class="text-muted fw-normal">@s.StartTime.ToString("HH:mm")-@s.EndTime.ToString("HH:mm") &middot; @item.GuestsBooked of @s.Capacity seats@(s.IsClosed ? " · Closed" : "")</span>
                </strong>
                <button type="button" class="btn-close bk-close" aria-label="Close"></button>
            </div>
            <div class="card-body py-2">

                @if (!s.IsClosed)
                {
                <details class="mb-2">
                    <summary class="btn btn-outline-primary btn-sm" style="list-style:none">+ Add booking</summary>
                    <form asp-controller="Reservations" asp-action="AddFromSchedule" method="post"
                          class="bk-add-form d-flex flex-wrap gap-2 align-items-end bg-light rounded p-2 mt-2"
                          data-date="@sel.ToString("yyyy-MM-dd")" data-start="@s.StartTime.ToString("HH:mm")"
                          data-end="@s.EndTime.ToString("HH:mm")" data-close="@closesAt.ToString("HH:mm")">
                        <input type="hidden" name="SittingId" value="@s.SittingId" />
                        <input type="hidden" name="Source" value="Phone" />
                        <input type="hidden" name="returnTo" value="@returnUrl" />
                        <input type="hidden" name="StartTime" value="" />
                             <div><label class="form-label small mb-0">Name</label><input type="text" name="Name" maxlength="60" required class="form-control form-control-sm" style="width:170px" /></div>
                        <div><label class="form-label small mb-0">Email (optional)</label><input type="email" name="Email" maxlength="256" class="form-control form-control-sm" style="width:170px" /></div>
                        <div><label class="form-label small mb-0">Phone</label><input type="text" name="PhoneNumber" required class="form-control form-control-sm" style="width:120px" /></div>
                        <div>
                            <label class="form-label small mb-0">Start time</label>
                            <div class="input-group input-group-sm flex-nowrap" style="width:auto">
                                <select class="form-select add-hour" style="min-width:5.5rem" aria-label="Start hour"><option>--</option></select>
                                <span class="input-group-text">:</span>
                                <select class="form-select add-minute" style="min-width:4.5rem" aria-label="Start minute"><option>--</option></select>
                            </div>
                        </div>
                        <div><label class="form-label small mb-0">Duration</label><select name="DurationMinutes" class="form-select form-select-sm add-duration" style="width:130px"><option>--</option></select></div>
                        <div><label class="form-label small mb-0">Guests</label><input type="number" name="NumberOfGuests" value="2" min="1" max="100" required class="form-control form-control-sm" style="width:64px" /></div>
                        <div><label class="form-label small mb-0">Notes</label><input type="text" name="SpecialRequests" maxlength="500" class="form-control form-control-sm" style="width:160px" /></div>
                        <button type="submit" class="btn btn-primary btn-sm">Add</button>
                        <div class="add-none text-danger small w-100" hidden>No times left to book in this sitting.</div>
                    </form>
                </details>
                }

                @if (list.Count == 0)
                {
                    <div class="text-muted">No bookings in this sitting yet.</div>
                }
                else
                {
                <table class="table table-sm align-middle mb-0">
                    <thead><tr class="text-muted"><th>Time</th><th>Name</th><th>Phone</th><th>Guests</th><th>Tables</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var b in list)
                    {
                        var canEdit = b.Status == ReservationStatus.Pending || b.Status == ReservationStatus.Confirmed;
                        // Still Pending or Confirmed after its day has passed. Worked out from the date; nothing is stored.
                        var isPast = canEdit && sel < RestaurantClock.Today;
                        var actions = new BookingActionsModel
                        {
                            ReservationId = b.ReservationId,
                            SittingId = b.SittingId,
                            Status = b.Status,
                            FirstName = b.FirstName,
                            LastName = b.LastName,
                            Email = b.Email,
                            Phone = b.Phone,
                            Start = b.Start,
                            Minutes = b.Minutes,
                            Guests = b.Guests,
                            Source = b.Source.ToString() ?? "",
                            Requests = b.Requests,
                            RowVersion = b.RowVersion,
                            TableIds = b.TableIds,
                            UnavailableTableIds = b.UnavailableTableIds,
                            Areas = Model.Areas,
                            ReturnUrl = returnUrl,
                            ColSpan = 6,
                            CanDelete = true,
                            IsPast = isPast,
                            IsPastDay = sel < RestaurantClock.Today
                        };
                        <tr data-booking data-start="@b.Start.ToString("HH:mm")" data-name="@b.Name" data-guests="@b.Guests" data-cancellable="@(canEdit ? "1" : "0")" class="@(b.Status == ReservationStatus.Cancelled ? "text-muted" : "")">
                            <td>@b.Start.ToString("HH:mm") <span class="text-muted">(@b.Minutes min)</span></td>
                            <td>
                                @b.Name
                                @if (b.Status != ReservationStatus.Cancelled && !string.IsNullOrEmpty(b.OriginalLabel) && b.OriginalLabel != s.Name)
                                {
                                    <div class="small"><span class="text-muted text-decoration-line-through">@b.OriginalLabel</span><br />@s.Name <span class="badge bg-secondary">Changed</span></div>
                                }
                            </td>
                            <td>@b.Phone</td>
                            <td>@b.Guests</td>
                            <td>@(b.TableNames.Count > 0 ? string.Join(", ", b.TableNames) : "-")</td>
                            <td>
                                @if (isPast)
                                {
                                    <span class="badge bg-secondary">Past</span>
                                    <div class="small text-muted">was @b.Status</div>
                                }
                                else
                                {
                                    <span class="badge @Badge(b.Status)">@b.Status</span>
                                }
                            </td>
                        </tr>
                        @if (!string.IsNullOrWhiteSpace(b.Requests))
                        {
                            <tr><td></td><td colspan="5" class="text-muted small pt-0">Request: @b.Requests</td></tr>
                        }
                        <partial name="_BookingActions" model="actions" />
                    }
                    </tbody>
                </table>
                }
            </div>
        </div>
    }
    </div>
}