@using BeanScene.Web.Controllers
@model ScheduleViewModel
@{
    ViewData["Title"] = "Sittings";
}
<link rel="stylesheet" href="~/css/sittings.css" asp-append-version="true" />

<partial name="_WeeklyHours" model="Model" />
<partial name="_Calendar" model="Model" />

<div id="dayArea">
    <partial name="_DayEditor" model="Model" />
    <partial name="_BookingPanels" model="Model" />
</div>

@section Scripts {
    <script src="~/js/booking-actions.js" asp-append-version="true"></script>
        <script src="~/js/time-boxes.js" asp-append-version="true"></script>
    <script src="~/js/sittings.js" asp-append-version="true"></script>
}