@model List<SittingListItem>
@{ ViewData["Title"] = "Sittings"; bool showPast = (object?)ViewBag.ShowPast is true; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Sittings</h1>
    <div>
        <a class="btn btn-outline-secondary btn-sm me-2" asp-action="Index" asp-route-showPast="@(!showPast)">@(showPast ? "Hide past sittings" : "Show past sittings")</a>
        <a class="btn btn-primary btn-sm" asp-action="Create">+ New sitting</a>
    </div>
</div>
<table class="table align-middle">
    <thead><tr><th>Date</th><th>Type</th><th>Time</th><th>Booked / capacity</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        var s = item.Sitting;
        <tr>
            <td>@s.SittingDate.ToString("ddd d MMM yyyy")</td>
            <td>@s.SittingType</td>
            <td>@s.StartTime.ToString("h:mm tt") - @s.EndTime.ToString("h:mm tt")</td>
            <td>@item.GuestsBooked / @s.Capacity</td>
            <td>@if (s.IsClosed) { <span class="badge text-bg-secondary">Closed (@s.ClosedReason)</span> } else { <span class="badge text-bg-success">Open</span> }</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s.SittingId">Edit</a>
                @if (s.IsClosed)
                {
                    <form asp-action="Reopen" asp-route-id="@s.SittingId" method="post" class="d-inline"><button class="btn btn-sm btn-outline-success">Reopen</button></form>
                }
                else
                {
                    <form asp-action="Close" asp-route-id="@s.SittingId" method="post" class="d-inline">
                        <input type="hidden" name="reason" value="BookedOut" />
                        <button class="btn btn-sm btn-outline-warning">Close (booked out)</button></form>
                    <form asp-action="Close" asp-route-id="@s.SittingId" method="post" class="d-inline">
                        <input type="hidden" name="reason" value="PrivateEvent" />
                        <button class="btn btn-sm btn-outline-warning">Close (private event)</button></form>
                }
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@s.SittingId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
