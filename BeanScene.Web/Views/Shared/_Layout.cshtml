<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bean Scene</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Bean Scene</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="Index">Book a table</a></li>
                    @if (User.IsInRole(RoleNames.Member))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Member" asp-action="Index">My reservations</a></li>
                                                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Details">My account</a></li>
                    }
                    @if (User.IsInRole(RoleNames.Staff) || User.IsInRole(RoleNames.Manager))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Reservations" asp-action="Index">Reservations</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Reservations" asp-action="FollowUp">Follow-up</a></li>
                    }
                    @if (User.IsInRole(RoleNames.Manager))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Sittings" asp-action="Index">Sittings</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="OrmDemo" asp-action="Index">ORM demo</a></li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><span class="navbar-text me-3">@User.Identity?.Name</span></li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<main class="container py-4">
    @if (TempData["Success"] is string ok)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">@ok
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">@err
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @RenderBody()
</main>

<footer class="border-top text-muted py-3">
    <div class="container small">&copy; Bean Scene reservation system - ICT50220 project</div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
