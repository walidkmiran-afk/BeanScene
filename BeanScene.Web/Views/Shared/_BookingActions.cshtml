@model BookingActionsModel
@{
    var b = Model;
    var canEdit = b.Status == ReservationStatus.Pending || b.Status == ReservationStatus.Confirmed;
    var canAssign = b.Status != ReservationStatus.Cancelled && b.Status != ReservationStatus.Completed;
    var buttons = new[]
    {
        (Action: "Confirm", Label: "Confirm", Css: "btn-primary", On: b.Status == ReservationStatus.Pending, Ask: (string?)null),
        (Action: "Seat", Label: "Seat", Css: "btn-info", On: canEdit, Ask: (string?)null),
        (Action: "Complete", Label: "Complete", Css: "btn-success", On: b.Status == ReservationStatus.Seated, Ask: (string?)null),
        (Action: "Cancel", Label: "Cancel", Css: "btn-outline-danger", On: canEdit, Ask: (string?)"Cancel this booking?"),
        (Action: "Delete", Label: "Delete", Css: "btn-outline-secondary", On: b.Status != ReservationStatus.Seated && b.Status != ReservationStatus.Completed, Ask: (string?)"Delete this booking permanently?")
    }.Where(x => x.Action != "Delete" || b.CanDelete).ToList();
}
<tr>
    <td colspan="@b.ColSpan" class="pt-0 pb-2">
        <div class="bk-actions">
            <button type="button" class="btn btn-outline-primary bk-edit-btn" data-rid="@b.ReservationId" disabled="@(!canEdit)">Edit</button>
            <button type="button" class="btn btn-outline-primary bk-assign-btn" data-rid="@b.ReservationId" disabled="@(!canAssign)">Tables</button>
            @foreach (var btn in buttons)
            {
                <form asp-controller="Reservations" asp-action="@btn.Action" asp-route-id="@b.ReservationId" method="post">
                    <input type="hidden" name="returnTo" value="@b.ReturnUrl" />
                    <button type="submit" class="btn @btn.Css" disabled="@(!btn.On)" onclick="@(btn.Ask != null ? "return confirm('" + btn.Ask + "')" : null)">@btn.Label</button>
                </form>
            }
        </div>
    </td>
</tr>
@if (canEdit)
{
    <tr class="bk-edit" data-rid="@b.ReservationId" style="display:none">
        <td colspan="@b.ColSpan" class="bg-light">
            <form asp-controller="Reservations" asp-action="EditFromSchedule" method="post" class="d-flex flex-wrap gap-2 align-items-end">
                <input type="hidden" name="ReservationId" value="@b.ReservationId" />
                <input type="hidden" name="SittingId" value="@b.SittingId" />
                <input type="hidden" name="RowVersion" value="@b.RowVersion" />
                <input type="hidden" name="Source" value="@b.Source" />
                <input type="hidden" name="Email" value="@b.Email" />
                <input type="hidden" name="returnTo" value="@b.ReturnUrl" />
                <div><label class="form-label small mb-0">First name</label><input type="text" name="FirstName" value="@b.FirstName" maxlength="60" required class="form-control form-control-sm" style="width:110px" /></div>
                <div><label class="form-label small mb-0">Last name</label><input type="text" name="LastName" value="@b.LastName" maxlength="60" required class="form-control form-control-sm" style="width:110px" /></div>
                <div><label class="form-label small mb-0">Phone</label><input type="text" name="PhoneNumber" value="@b.Phone" required class="form-control form-control-sm" style="width:120px" /></div>
                <div><label class="form-label small mb-0">Start</label><input type="text" name="StartTime" value="@b.Start.ToString("HH:mm")" maxlength="5" pattern="([01][0-9]|2[0-3]):[0-5][0-9]" title="Start time, for example 12:30" required class="form-control form-control-sm" style="width:64px" /></div>
                <div><label class="form-label small mb-0">Minutes</label><input type="number" name="DurationMinutes" value="@b.Minutes" min="30" max="180" required class="form-control form-control-sm" style="width:70px" /></div>
                <div><label class="form-label small mb-0">Guests</label><input type="number" name="NumberOfGuests" value="@b.Guests" min="1" max="100" required class="form-control form-control-sm" style="width:64px" /></div>
                <div><label class="form-label small mb-0">Notes</label><input type="text" name="SpecialRequests" value="@b.Requests" maxlength="500" class="form-control form-control-sm" style="width:180px" /></div>
                <div>
                    <button type="submit" class="btn btn-primary btn-sm py-0">Save booking</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 bk-form-cancel" data-rid="@b.ReservationId">Cancel edit</button>
                </div>
            </form>
        </td>
    </tr>
}
@if (canAssign)
{
    <tr class="bk-assign" data-rid="@b.ReservationId" style="display:none">
        <td colspan="@b.ColSpan" class="bg-light">
            <form asp-controller="Reservations" asp-action="AssignFromSchedule" asp-route-id="@b.ReservationId" method="post">
                <input type="hidden" name="returnTo" value="@b.ReturnUrl" />
                @foreach (var area in b.Areas)
                {
                    <div class="fw-semibold small mt-1">@area.AreaName</div>
                    <div class="d-flex flex-wrap gap-1 mb-1">
                    @foreach (var t in area.Tables)
                    {
                        var unavailable = b.UnavailableTableIds.Contains(t.TableId);
                        var chosen = b.TableIds.Contains(t.TableId);
                        <div>
                            <input type="checkbox" class="btn-check" id="t@(b.ReservationId)_@(t.TableId)" name="selectedTableIds" value="@t.TableId" checked="@(chosen && !unavailable)" disabled="@unavailable" />
                            <label class="btn btn-outline-primary btn-sm py-0" for="t@(b.ReservationId)_@(t.TableId)" title="Seats @t.Capacity">@t.TableName</label>
                        </div>
                    }
                    </div>
                }
                <div class="small text-muted mb-1">Greyed-out tables are held by another booking at an overlapping time in this sitting.</div>
                <button type="submit" class="btn btn-primary btn-sm py-0">Save tables</button>
                <button type="button" class="btn btn-outline-secondary btn-sm py-0 bk-form-cancel" data-rid="@b.ReservationId">Cancel</button>
            </form>
        </td>
    </tr>
}