@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset password"; }
<div class="row justify-content-center"><div class="col-md-8 col-lg-6">
    <h1 class="h3 mb-3">Reset password</h1>
    <p class="text-muted">Set a new password for <strong>@ViewBag.Email</strong>. Tell them the new password in person or by phone.</p>
    <form asp-action="ResetPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="UserId" />
        <div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-danger"></span></div>
        <div class="mb-1"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
        <div class="form-text mb-3">At least 8 characters with an uppercase letter, a digit and a symbol.</div>
        <button class="btn btn-primary" type="submit">Reset password</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }