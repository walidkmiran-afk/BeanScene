@model List<AccountRowViewModel>
@{ ViewData["Title"] = "Accounts"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Accounts</h1>
    <a class="btn btn-primary btn-sm" asp-action="Create">+ New staff account</a>
</div>
<p class="text-muted">Staff and member logins. A disabled account cannot log in, and its history is kept. Manager accounts are not listed here.</p>
<div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Name</th><th>Role</th><th>Email</th><th>Phone</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var a in Model)
        {
            var toggle = a.IsDisabled ? "Enable" : "Disable";
            <tr>
                <td>@a.FullName</td>
                <td>@a.Role</td>
                <td>@a.Email</td>
                <td>@a.PhoneNumber</td>
                <td>
                    @if (a.IsDisabled) { <span class="badge bg-secondary">Disabled</span> }
                    else { <span class="badge bg-success">Active</span> }
                </td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@a.UserId">Edit</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="ResetPassword" asp-route-id="@a.UserId">Reset password</a>
                    <form asp-action="ToggleDisabled" asp-route-id="@a.UserId" method="post" class="d-inline"
                          onsubmit="return confirm('@toggle this account?');">
                        <button class="btn btn-sm @(a.IsDisabled ? "btn-outline-success" : "btn-outline-danger")">@toggle</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>