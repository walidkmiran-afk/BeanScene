@using Microsoft.AspNetCore.Mvc.Rendering
@using BeanScene.Web.Data
@using BeanScene.Web.Services
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@model List<Reservation>
@{
    ViewData["Title"] = "Reservations";
    var c = (ReservationSearchCriteria)ViewBag.Criteria;
    var unavailable = (Dictionary<int, HashSet<int>>)ViewBag.Unavailable;
    var returnTo = Context.Request.Path.Value + Context.Request.QueryString.Value;
    var areas = await Db.Areas.AsNoTracking().Include(a => a.Tables).OrderBy(a => a.AreaId).ToListAsync();
    var isManager = User.IsInRole(RoleNames.Manager);
}
<div class="mx-auto" style="max-width:960px">

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Reservations</h1>
    <a class="btn btn-primary btn-sm" asp-controller="Booking" asp-action="Index">+ New reservation</a>
</div>

<partial name="_ReservationSearch" model="c" view-data="@(new ViewDataDictionary(ViewData) { { "ShowStatus", true } })" />

<div id="resList" class="bk-area">
@if (!Model.Any())
{
    <p class="text-muted">No reservations match your search.</p>
}
else
{
    DateOnly? lastDate = null;
    var lastSitting = 0;
    <table class="table align-middle bk-list">
        <thead>
            <tr>
                <th class="d-none d-md-table-cell">#</th>
                <th>Sitting</th>
                <th>Start</th>
                <th>Guest</th>
                <th>Guests</th>
                <th class="d-none d-md-table-cell">Source</th>
                <th>Tables</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model)
        {
            // Still Pending or Confirmed after its day has passed. Worked out from the date each time; nothing is stored.
            var isPast = r.Sitting.SittingDate < RestaurantClock.Today
                         && (r.Status == ReservationStatus.Pending || r.Status == ReservationStatus.Confirmed);
            var actions = new BookingActionsModel
            {
                ReservationId = r.ReservationId,
                SittingId = r.SittingId,
                Status = r.Status,
                FirstName = r.Customer.FirstName,
                LastName = r.Customer.LastName,
                Email = r.Customer.Email,
                Phone = r.Customer.PhoneNumber,
                Start = r.StartTime,
                Minutes = r.DurationMinutes,
                Guests = r.NumberOfGuests,
                Source = r.Source.ToString(),
                Requests = r.SpecialRequests,
                RowVersion = r.RowVersion,
                TableIds = r.ReservationTables.Select(rt => rt.TableId).ToList(),
                UnavailableTableIds = unavailable.TryGetValue(r.ReservationId, out var taken) ? taken : new HashSet<int>(),
                Areas = areas,
                ReturnUrl = returnTo,
                ColSpan = 8,
                CanDelete = isManager,
                IsPast = isPast
            };

            // A dark bar when a new day starts, and a light bar when a new sitting starts.
            if (lastDate != r.Sitting.SittingDate)
            {
                var dayCount = Model.Count(x => x.Sitting.SittingDate == r.Sitting.SittingDate);
                <tr class="table-secondary" style="--bs-table-bg:#c4c9ce">
                    <td colspan="8" class="fw-semibold py-2">@r.Sitting.SittingDate.ToString("dddd d MMMM yyyy") <span class="fw-normal">&middot; @dayCount @(dayCount == 1 ? "booking" : "bookings")</span></td>
                </tr>
            }
            if (lastSitting != r.SittingId)
            {
                var sittingCount = Model.Count(x => x.SittingId == r.SittingId);
                <tr class="table-primary">
                    <td colspan="8" class="small fw-semibold">@r.Sitting.Name <span class="fw-normal">&middot; @r.Sitting.StartTime.ToString("h:mm tt") to @r.Sitting.EndTime.ToString("h:mm tt") &middot; @sittingCount @(sittingCount == 1 ? "booking" : "bookings")</span></td>
                </tr>
            }
            lastDate = r.Sitting.SittingDate;
            lastSitting = r.SittingId;

            <tr class="bk-main @(r.Status == ReservationStatus.Cancelled ? "text-muted" : "")">
                <td class="d-none d-md-table-cell">@r.ReservationId</td>
                <td><partial name="_SittingLabel" model="r" /></td>
                <td>@r.StartTime.ToString("h:mm tt")<br /><span class="small text-muted">@r.DurationMinutes min</span></td>
                <td>@r.Customer.FullName<br /><span class="small text-muted">@r.Customer.PhoneNumber<span class="d-none d-lg-inline"> &middot; @r.Customer.Email</span></span></td>
                <td>@r.NumberOfGuests</td>
                <td class="d-none d-md-table-cell">@r.Source</td>
                <td>@(r.ReservationTables.Any() ? string.Join(", ", r.ReservationTables.Select(rt => rt.Table.TableName).OrderBy(n => n)) : "-")</td>
                <td>
                    @if (isPast)
                    {
                        <span class="badge bg-secondary">Past</span>
                        <div class="small text-muted">was @r.Status</div>
                    }
                    else
                    {
                        <span class="badge @UiHelpers.StatusBadge(r.Status)">@r.Status</span>
                    }
                </td>
            </tr>
            @if (!string.IsNullOrWhiteSpace(r.SpecialRequests))
            {
                <tr><td colspan="8" class="text-muted small pt-0">Request: @r.SpecialRequests</td></tr>
            }
            <partial name="_BookingActions" model="actions" />
        }
        </tbody>
    </table>
}
</div>

</div>

@section Scripts {
    <script src="~/js/booking-actions.js" asp-append-version="true"></script>
}