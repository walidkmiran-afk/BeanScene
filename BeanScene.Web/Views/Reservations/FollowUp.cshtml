@using BeanScene.Web.Data
@using BeanScene.Web.Services
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@model BeanScene.Web.DataStructures.PendingFollowUpQueue
@{
    ViewData["Title"] = "Follow-up";
    var c = (ReservationSearchCriteria)ViewBag.Criteria;
    bool searching = (object?)ViewBag.Searching is true;
    int totalPending = (int)ViewBag.TotalPending;
    var unavailable = (Dictionary<int, HashSet<int>>)ViewBag.Unavailable;
    var returnTo = Context.Request.Path.Value + Context.Request.QueryString.Value;
    var areas = await Db.Areas.AsNoTracking().Include(a => a.Tables).OrderBy(a => a.AreaId).ToListAsync();
    var isManager = User.IsInRole(RoleNames.Manager);
    var searchOptions = new ViewDataDictionary(ViewData) { { "ShowStatus", false }, { "MinToday", true } };

    // A plain list of the queue, in the same order, so it can be counted for the day and sitting bars.
    var all = new List<Reservation>();
    foreach (var item in Model) all.Add(item);
}
<div class="mx-auto" style="max-width:960px">

<h1 class="h3 mb-1">Reservations to follow up</h1>
<p class="text-muted">Soonest sitting first (merge sort, stored in a doubly linked list). A booking stays here until it is completed or cancelled.</p>

<partial name="_ReservationSearch" model="c" view-data="searchOptions" />

<div id="fuList" class="bk-area">
@if (searching)
{
    <p class="text-muted small mb-2">Showing <strong>@all.Count</strong> of <strong>@totalPending</strong> open bookings. <a asp-action="FollowUp">Clear search</a></p>
}
else
{
    <p class="text-muted small mb-2"><strong>@all.Count</strong> open bookings.</p>
}

@if (all.Count == 0)
{
    <p class="text-muted">@(searching ? "No open bookings match your search." : "Nothing to follow up.")</p>
}
else
{
    DateOnly? lastDate = null;
    var lastSitting = 0;
    <table class="table align-middle bk-list">
        <thead>
            <tr>
                <th>Sitting</th>
                <th>Start</th>
                <th>Guest</th>
                <th>Guests</th>
                <th>Tables</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in all)
        {
            var actions = new BookingActionsModel
            {
                ReservationId = r.ReservationId,
                SittingId = r.SittingId,
                Status = r.Status,
                FirstName = r.Customer.FirstName,
                LastName = r.Customer.LastName,
                Email = r.Customer.Email,
                Phone = r.Customer.PhoneNumber,
                Start = r.StartTime,
                Minutes = r.DurationMinutes,
                Guests = r.NumberOfGuests,
                Source = r.Source.ToString(),
                Requests = r.SpecialRequests,
                RowVersion = r.RowVersion,
                TableIds = r.ReservationTables.Select(rt => rt.TableId).ToList(),
                UnavailableTableIds = unavailable.TryGetValue(r.ReservationId, out var taken) ? taken : new HashSet<int>(),
                Areas = areas,
                ReturnUrl = returnTo,
                ColSpan = 5,
                CanDelete = isManager,
                IsPastDay = r.Sitting.SittingDate < RestaurantClock.Today
            };

            // A grey bar when a new day starts, and a light blue bar when a new sitting starts.
            if (lastDate != r.Sitting.SittingDate)
            {
                var dayCount = all.Count(x => x.Sitting.SittingDate == r.Sitting.SittingDate);
                <tr class="table-secondary" style="--bs-table-bg:#c4c9ce">
                    <td colspan="5" class="fw-semibold py-2">@r.Sitting.SittingDate.ToString("dddd d MMMM yyyy") <span class="fw-normal">&middot; @dayCount @(dayCount == 1 ? "booking" : "bookings")</span></td>
                </tr>
            }
            if (lastSitting != r.SittingId)
            {
                var sittingCount = all.Count(x => x.SittingId == r.SittingId);
                <tr class="table-primary">
                    <td colspan="5" class="small fw-semibold">@r.Sitting.Name <span class="fw-normal">&middot; @r.Sitting.StartTime.ToString("h:mm tt") to @r.Sitting.EndTime.ToString("h:mm tt") &middot; @sittingCount @(sittingCount == 1 ? "booking" : "bookings")</span></td>
                </tr>
            }
            lastDate = r.Sitting.SittingDate;
            lastSitting = r.SittingId;

            <tr class="bk-main">
                <td><partial name="_SittingLabel" model="r" /></td>
                <td>@r.StartTime.ToString("h:mm tt")<br /><span class="small text-muted">@r.DurationMinutes min</span></td>
                <td>@r.Customer.FullName<br /><span class="small text-muted">@r.Customer.PhoneNumber<span class="d-none d-lg-inline"> &middot; @r.Customer.Email</span></span></td>
                <td>@r.NumberOfGuests</td>
                <td>@(r.ReservationTables.Any() ? string.Join(", ", r.ReservationTables.Select(rt => rt.Table.TableName).OrderBy(n => n)) : "-")</td>
            </tr>
            @if (!string.IsNullOrWhiteSpace(r.SpecialRequests))
            {
                <tr><td colspan="5" class="text-muted small pt-0">Request: @r.SpecialRequests</td></tr>
            }
            <partial name="_BookingActions" model="actions" />
        }
        </tbody>
    </table>
}
</div>

</div>

@section Scripts {
    <script src="~/js/booking-actions.js" asp-append-version="true"></script>
}