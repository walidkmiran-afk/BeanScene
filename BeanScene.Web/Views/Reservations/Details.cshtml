@model Reservation
@{ ViewData["Title"] = "Reservation #" + Model.ReservationId; var returnTo = Url.Action("Details", new { id = Model.ReservationId }); }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Reservation #@Model.ReservationId <span class="badge @UiHelpers.StatusBadge(Model.Status)">@Model.Status</span></h1>
    <a asp-action="Index">Back to list</a>
</div>

<div class="row">
    <div class="col-md-7">
        <dl class="row">
            <dt class="col-sm-4">Sitting</dt><dd class="col-sm-8">@Model.Sitting.DisplayName</dd>
            <dt class="col-sm-4">Time</dt><dd class="col-sm-8">@Model.StartTime.ToString("h:mm tt") to @Model.EndTime.ToString("h:mm tt") (@Model.DurationMinutes min)</dd>
            <dt class="col-sm-4">Guests</dt><dd class="col-sm-8">@Model.NumberOfGuests</dd>
            <dt class="col-sm-4">Source</dt><dd class="col-sm-8">@Model.Source</dd>
            <dt class="col-sm-4">Guest</dt><dd class="col-sm-8">@Model.Customer.FullName</dd>
            <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Customer.Email</dd>
            <dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@Model.Customer.PhoneNumber</dd>
            <dt class="col-sm-4">Notes</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.SpecialRequests) ? "-" : Model.SpecialRequests)</dd>
            <dt class="col-sm-4">Tables</dt>
            <dd class="col-sm-8">
                @if (Model.ReservationTables.Any())
                {
                    @(string.Join(", ", Model.ReservationTables.Select(rt => rt.Table.TableName + " (" + rt.Table.Area.AreaName + ")").OrderBy(n => n)))
                }
                else { <span class="text-muted">None assigned</span> }
            </dd>
        </dl>
    </div>
    <div class="col-md-5">
        <div class="card"><div class="card-body d-grid gap-2">
            @if (Model.Status is ReservationStatus.Pending or ReservationStatus.Confirmed)
            {
                <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.ReservationId">Edit details</a>
            }
            @if (Model.Status != ReservationStatus.Cancelled && Model.Status != ReservationStatus.Completed)
            {
                <a class="btn btn-outline-primary" asp-controller="Allocation" asp-action="Allocate" asp-route-id="@Model.ReservationId">Assign tables</a>
            }
            @if (Model.Status == ReservationStatus.Pending)
            {
                <form asp-action="Confirm" asp-route-id="@Model.ReservationId" method="post" class="d-grid">
                    <input type="hidden" name="returnTo" value="@returnTo" /><button class="btn btn-primary">Confirm reservation</button></form>
            }
            @if (Model.Status is ReservationStatus.Pending or ReservationStatus.Confirmed)
            {
                <form asp-action="Seat" asp-route-id="@Model.ReservationId" method="post" class="d-grid">
                    <input type="hidden" name="returnTo" value="@returnTo" /><button class="btn btn-info">Seat guests</button></form>
                <form asp-action="Cancel" asp-route-id="@Model.ReservationId" method="post" class="d-grid">
                    <input type="hidden" name="returnTo" value="@returnTo" /><button class="btn btn-outline-danger">Cancel reservation</button></form>
            }
            @if (Model.Status == ReservationStatus.Seated)
            {
                <form asp-action="Complete" asp-route-id="@Model.ReservationId" method="post" class="d-grid">
                    <input type="hidden" name="returnTo" value="@returnTo" /><button class="btn btn-success">Mark completed</button></form>
            }
            @if (User.IsInRole(RoleNames.Manager))
            {
                <form asp-action="Delete" asp-route-id="@Model.ReservationId" method="post" class="d-grid"
                      onsubmit="return confirm('Delete this reservation permanently?');">
                    <button class="btn btn-outline-secondary btn-sm">Delete (Manager)</button></form>
            }
        </div></div>
    </div>
</div>
