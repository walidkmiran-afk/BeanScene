@model ReservationInput
@{
    ViewData["Title"] = "Book a table";
    bool isMember = (object?)ViewBag.IsMember is true;
    var fieldOptions = new ViewDataDictionary(ViewData) { { "LockGuest", isMember }, { "ShowSource", false } };
}
<div class="row justify-content-center"><div class="col-lg-9">
    <h1 class="h3 mb-3">Book a table</h1>
    <form asp-action="Index" method="post">
        <partial name="_ReservationFields" model="Model" view-data="fieldOptions" />
        <button class="btn btn-primary" type="submit">Request reservation</button>
        <p class="text-muted small mt-2">Your reservation is Pending until the restaurant confirms it by phone.</p>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
