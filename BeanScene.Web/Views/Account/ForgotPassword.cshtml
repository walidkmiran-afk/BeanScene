@{
    ViewData["Title"] = "Forgot password";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="p-2 mb-4 text-center border border-dark"
             style="background: repeating-linear-gradient(45deg, #ffc107, #ffc107 12px, #212529 12px, #212529 24px);">
            <span class="bg-warning text-dark fw-bold px-3 py-1 d-inline-block">UNDER CONSTRUCTION</span>
        </div>
        <h1 class="h3 mb-3">Forgot your password?</h1>
        <p>Password reset by email isn't available yet. Bean Scene is a TAFE project, so it has no way to send reset emails, and the accounts in it are test accounts with email addresses that may not be real. If you've forgotten your password, please contact the manager or system administrator and they'll set a new one for you.</p>
        <a class="btn btn-primary" asp-action="Login">Back to log in</a>
    </div></div>